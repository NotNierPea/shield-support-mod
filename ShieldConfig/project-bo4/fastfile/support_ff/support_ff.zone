// command: .\acts.exe fastfilelinker ShieldConfig\project-bo4\fastfile\support_ff\support_ff.zone -o 'C:\Program Files (x86)\Call of Duty Black Ops 4\project-bo4'
// example and test file for the fastfile linker

// fastfile options
>game=bo4              // the game to use
>name=support        // fastfile name
>compression=zlib      // compression type, by default no compression is used
>compression.high=true // use high compression

// images, the file will be searched in the images directory. the file extension will be removed
image,wanted_cred.png
image,eagle_cred.png
image,peawhatever_cred.png
image,bodnjenie_cred.png
image,ate47_cred.png
image,mod_manager_rush.png
image,mod_manager_french.png
image,mod_manager_surv.png
image,mod_manager_kim.png
image,mod_manager_abom.png
image,mod_manager_synergy.png
image,mod_manager_timers.png
image,mm_icon.png
image,shield_public_banner.png
image,loading_shield.png

// custom camos (camo index 399 and up): shield-client's custom_camos.cpp lays the sets of shield_camos on each
// weapon's own camo (the set's "template"), materials/ and templates/ are the camo materials, the csv is the menu's list
weaponcamo,tables/weaponcamo/shield_camos.json
stringtable,gamedata/shield/custom_camos.csv
image,shield_camo_circuit_prev.png
image,shield_camo_digital_prev.png

// startup video sound: shield-client's intro.cpp gives an overridden video (project-bo4/video/<name>.bk2) the alias
// shield_bik_<name> in place of the game's bik_<name>; settings copied from core_bootstrap.all's bik_logo_cinematic
sound,sounds/support_sounds.json
