// crew vox: end

// jacket: begin
// Payday 3's Jacket, a specialist of multiplayer, a Blackout and a zombies character (shield-client makes his roles
// from the config's "characters"). BO4 Custom Maps/Jacket (BO4)/tools/build_jacket.py writes these lines and his
// files here: edit them there and run it again
// his body (his mask on it) on the MP body skeleton, the empty head slot, his first person arms and legs
xmodel,xmodels/c_t8_jacket.json
xmodel,xmodels/c_t8_jacket_head.json
xmodel,xmodels/c_t8_jacket_arms.json
xmodel,xmodels/c_t8_jacket_legs.json

// his pictures (the config's portrait, icon, images and bundle values name them), his game's icon (Outfits.lua)
image,jacket_icon.png,nomips
image,jacket_portrait.png,nomips
image,jacket_render.png,nomips
image,jacket_action.png,nomips
image,jacket_bio_header.png,nomips
image,jacket_card.png,nomips
image,jacket_story.png,nomips
image,jacket_emblem.png,nomips
image,jacket_outfit_default.png,nomips
image,jacket_game_pd3.png,nomips

// his battle chatter: the bundle his body type names (getmpdialogname "jacket"); its lines are in support.all
// (sounds/support_sounds.json, the aliases vox_jacket_*), their subtitles in gamedata/shield/subtitles.csv
scriptbundle,mpdialog_player/jacket

// his models cached (the frontend spawns them), his lines (the player entity plays them)
bgcache,characters/jacket/bgcache.csv
// jacket: end

// zm vox: begin
// the zombies copies of the MP specialists: their lines (vox_zmc_<specialist>_<line> in support.all; the
// others play their crew lines, ZombiesVoxTable.gsc). BO4 Custom Maps/Core/tools/build_zm_vox.py writes these lines
bgcache,characters/zm_vox/bgcache.csv
// zm vox: end

// jacket weapon: begin
// Jacket's specialist weapon (MP): the bat's models (their material and images in them), name and icon; the weapons
// themselves are in support_mp.zone (mp_common). BO4 Custom Maps/Jacket (BO4)/tools/build_jacket_weapon.py writes this
xmodel,xmodels/c_t8_jacket_bat_view.json
xmodel,xmodels/c_t8_jacket_bat_world.json
xmodel,xmodels/c_t8_jacket_bat_projectile.json
localizelist,weapons/jacket/weapon_strings.json
// its icon in the character select / Specialist HQ (SpecialistWeapons.lua)
image,jacket_bat_icon.png,nomips
// its HUD icons (the weapons name them in place of the Ripper's: ready, charging, its pictures, the kill feed's)
image,jacket_bat_hud_ready.png,nomips
image,jacket_bat_hud_charging.png,nomips
image,jacket_bat_hud.png,nomips
image,jacket_bat_hud_dark.png,nomips
image,jacket_bat_hud_line.png,nomips
image,jacket_bat_hud_small.png,nomips
// jacket weapon: end

// freerun: begin
// freerun (the support mod's Freerun.gsc): mp_bully's race rings and sounds as shield_freerun_*, BO4 Custom
// Maps/Bullworth (BO4)/tools/freerun_support.py writes these lines; the aliases are in support.all
xmodel,xmodels/shield_freerun_ring.json
xmodel,xmodels/shield_freerun_chev1.json
xmodel,xmodels/shield_freerun_chev2.json
xmodel,xmodels/shield_freerun_chev3.json
xmodel,xmodels/shield_freerun_arrows.json
xmodel,xmodels/shield_freerun_final.json
xmodel,xmodels/shield_freerun_flash1.json
xmodel,xmodels/shield_freerun_flash2.json
xmodel,xmodels/shield_freerun_flags.json
xmodel,xmodels/shield_freerun_beam.json
xmodel,xmodels/shield_freerun_marker.json
image,shield_freerun_waypoint_icon.png,nomips
objective,scriptbundle/objective_shield_freerun_waypoint.json
bgcache,freerun/bgcache.csv
// freerun: end

// misty: begin
// Black Ops II's Misty, an outfit of Misty (zombies, Blackout; the config's "outfit_adds"). BO4 Custom Maps/
// Misty (BO4)/tools/build_misty.py writes these lines and its files here: edit them there and run it again
// her body on the zombies body skeleton, her head on stock Misty's (its face shapes, ponytail physics, war paint face), her first person arms and legs
xmodel,xmodels/c_t8_misty_bo2.json
xmodel,xmodels/c_t8_misty_bo2_head.json
xmodel,xmodels/c_t8_misty_bo2_arms.json
xmodel,xmodels/c_t8_misty_bo2_legs.json

// her picture in the outfit list, her ZM HUD portrait, her scoreboard / party list icon (OutfitPortraits.lua, SprayGestureWheel.lua)
image,misty_outfit.png,nomips
image,misty_hud.png,nomips
image,misty_portrait.png,nomips

// its models cached (the frontend spawns them)
bgcache,characters/misty/bgcache.csv
// misty: end
