xmodel,xmodels/c_t8_kagan_beta_arms.json
xmodel,xmodels/c_t8_kagan_beta_legs.json

// her pictures (the config's portrait, icon, images and bundle values name them), her game's icon (Outfits.lua)
image,kagan_icon.png,nomips
image,kagan_portrait.png,nomips
image,kagan_render.png,nomips
image,kagan_action.png,nomips
image,kagan_bio_header.png,nomips
