image,mod_manager_timers.png
image,mod_manager_vod_day.png
image,mm_icon.png
image,shield_freerun_tile.png
image,mm_unknown_mod.png
// the Mod Manager card's previews (ModManager.lua catalog "previews")
image,mm_prev_zm_park_1.png
image,mm_prev_zm_room_1.png
image,mm_prev_vod_day_1.png
image,shield_public_banner.png
image,loading_shield.png

// custom camos (camo index 399 and up)
