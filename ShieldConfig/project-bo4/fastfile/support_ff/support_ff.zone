// wesker: begin
// Resident Evil 5's Albert Wesker, a specialist of multiplayer and a Blackout character (shield-client makes his
// roles from the config's "characters"). BO4 Custom Maps/Wesker (BO4)/tools/build_wesker.py writes these lines
// and his files here: edit them there and run it again
// his body on the MP body skeleton (Ruin's), his own proportions; the empty head slot; his first person arms
// (the view arms skeleton) and legs
xmodel,xmodels/c_t8_wesker.json
xmodel,xmodels/c_t8_wesker_head.json
xmodel,xmodels/c_t8_wesker_face.json
xmodel,xmodels/c_t8_wesker_arms.json
xmodel,xmodels/c_t8_wesker_legs.json

// his test outfits (the config's "outfits": the base's outfit 1 red, 2 blue), his clothes recoloured
xmodel,xmodels/c_t8_wesker_red.json
xmodel,xmodels/c_t8_wesker_red_arms.json
xmodel,xmodels/c_t8_wesker_red_legs.json
xmodel,xmodels/c_t8_wesker_blue.json
xmodel,xmodels/c_t8_wesker_blue_arms.json
xmodel,xmodels/c_t8_wesker_blue_legs.json

// his pictures (the config's portrait, icon, images and bundle values name them)
image,wesker_icon.png,nomips
image,wesker_portrait.png,nomips
image,wesker_render.png,nomips
image,wesker_action.png,nomips
image,wesker_bio_header.png,nomips
image,wesker_card.png,nomips
image,wesker_story.png,nomips
image,wesker_emblem.png,nomips
image,wesker_outfit_default.png,nomips
image,wesker_outfit_red.png,nomips
image,wesker_outfit_blue.png,nomips
// his game's icon in WZ's character select (Outfits.lua)
image,wesker_game_re5.png,nomips

// his battle chatter: the bundle his body type names (getmpdialogname "wesker"); its lines are in support.all
// (sounds/support_sounds.json, the aliases vox_wesker_*)
scriptbundle,mpdialog_player/wesker

// the subtitles of his lines (their aliases name these entries)
localizelist,characters/wesker/vox_strings.json

// his models cached (the frontend spawns them), his lines (the player entity plays them)
bgcache,characters/wesker/bgcache.csv
// wesker: end

// peaks: begin
// Black Ops 6's Peeks bunny, an outfit of Scarlett (zombies, Blackout; the config's "outfit_adds").
physconstraints,physconstraints/shield_peaks_ears.json
xmodel,xmodels/c_t8_peaks.json
xmodel,xmodels/c_t8_peaks_head.json
xmodel,xmodels/c_t8_peaks_arms.json
xmodel,xmodels/c_t8_peaks_legs.json

// its picture in the outfit list, its ZM HUD portrait, its scoreboard / party list icon (SprayGestureWheel.lua)
image,peaks_outfit.png,nomips
image,peaks_hud.png,nomips
image,peaks_portrait.png,nomips

// its models cached (the frontend spawns them)
bgcache,characters/peaks/bgcache.csv
// peaks: end

// wesker weapon: begin
// Wesker's specialist weapon (MP): its models (their materials and images in them), fire sounds and name; the weapon
// itself is in support_mp.zone (mp_common: its anims and effects). BO4 Custom Maps/Wesker (BO4)/tools/build_wesker_weapon.py writes this
xmodel,xmodels/c_t8_wesker_gun_view.json
xmodel,xmodels/c_t8_wesker_gun_world.json
localizelist,weapons/wesker/weapon_strings.json
// its icon in the character select / Specialist HQ (SpecialistWeapons.lua)
image,wesker_gun_icon.png,nomips
// its HUD icons (the weapon names them in place of the Annihilator's: ready, charging, its pictures, the kill feed's)
image,wesker_gun_hud_ready.png,nomips
image,wesker_gun_hud_charging.png,nomips
image,wesker_gun_hud.png,nomips
image,wesker_gun_hud_small.png,nomips
image,wesker_gun_hud_line.png,nomips
// wesker weapon: end

// list arrows: begin
// the character select lists' arrows (the support mod's Lua DraftArrows.lua: more characters above / below), the
// frontend hasn't the game's uie_ui_arrow_up / down
image,shield_list_arrow_up.png,nomips
image,shield_list_arrow_down.png,nomips
// list arrows: end


// mascot: begin
// Bully's School Mascot (Chapter IV's bull costume), an outfit of Spectre (MP, Blackout; the config's "outfit_adds").
// BO4 Custom Maps/School Mascot (BO4)/tools/build_mascot.py writes these lines and its files here: edit them there and run it again
// the costume on the MP body skeleton (its bull head in it: the head slot is Wesker's empty one), its first person arms and legs
// its nose ring's swing (the body model names it)
physconstraints,physconstraints/shield_mascot_ring.json
xmodel,xmodels/c_t8_mascot.json
xmodel,xmodels/c_t8_mascot_arms.json
xmodel,xmodels/c_t8_mascot_legs.json

// its picture in the outfit list
image,mascot_outfit.png,nomips

// its models cached (the frontend spawns them)
bgcache,characters/mascot/bgcache.csv
// mascot: end

