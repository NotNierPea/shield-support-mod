xanim,anims/shield_ges_sb_fireworks.json
material,materials/shield_sbfw_fx_12989276870346519587.json
fx,fx/shield_sbfw/burst.json
fx,fx/shield_sbfw/fuse.json
gesture,gestures/sb_fireworks/ges_shield_sb_fireworks.json
gesture,gestures/sb_fireworks/ges_shield_sb_fireworks_2.json
sprayorgestureitem,gestures/sb_fireworks/shield_sb_fireworks.json
sprayorgesturelist,gestures/sb_fireworks/list.json
localizelist,gestures/sb_fireworks/strings.json
bgcache,gestures/sb_fireworks/bgcache.csv
